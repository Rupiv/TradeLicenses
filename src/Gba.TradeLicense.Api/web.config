<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        WebDAV Publishing intercepts PUT/DELETE before they reach the ASP.NET Core app,
        returning IIS's generic "405 - HTTP verb used to access this page is not allowed"
        page instead of hitting the controller (e.g. the login-master PUT/DELETE routes).
        Remove it so those verbs reach AspNetCoreModuleV2 like GET/POST already do.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Gba.TradeLicense.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
